+        assert_eq!(decode_source(Vec::new()).unwrap(), "");
+    }
+
+    #[test]
+    /// Only a leading UTF-8 BOM is removed; a BOM-only file decodes to nothing.
+    fn utf8_bom_is_stripped_once() {
+        assert_eq!(
+            decode_source(b"\xef\xbb\xbfclass C {}".to_vec()).unwrap(),
+            "class C {}"
+        );
+        assert_eq!(decode_source(b"\xef\xbb\xbf".to_vec()).unwrap(), "");
+        assert_eq!(
+            decode_source(b"\xef\xbb\xbf\xef\xbb\xbfx".to_vec()).unwrap(),
+            "\u{feff}x"
+        );
+    }
+
+    #[test]
+    /// Invalid UTF-8 is rejected with offsets counted after the BOM, as before.
+    fn invalid_utf8_reports_offset_after_bom() {
+        let error = decode_source(b"ab\xff".to_vec()).unwrap_err();
+        assert!(format!("{error:#}").contains("invalid UTF-8 source"));
+        assert!(format!("{error:#}").contains("index 2"), "{error:#}");
+        let error = decode_source(b"\xef\xbb\xbfab\xff".to_vec()).unwrap_err();
+        assert!(format!("{error:#}").contains("index 2"), "{error:#}");
+    }
+
+    #[test]
+    /// BOM-marked UTF-16 decodes in both byte orders, including non-BMP characters.
+    fn utf16_decodes_both_byte_orders() {
+        for little_endian in [true, false] {
+            assert_eq!(
+                decode_source(utf16("class C { /* \u{1f600} */ }", little_endian)).unwrap(),
+                "class C { /* \u{1f600} */ }"
+            );
+        }
+    }
+
+    #[test]
+    /// Odd-length or unpaired-surrogate UTF-16 is rejected.
+    fn malformed_utf16_is_rejected() {
+        let mut odd = utf16("ab", true);
+        odd.push(0);
+        assert!(decode_source(odd).is_err());
+        assert!(decode_source(vec![0xff, 0xfe, 0x00, 0xd8]).is_err());
     }
 }
