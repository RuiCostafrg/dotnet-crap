+/// Validated evidence for one source file in the compact form the scan needs.
+pub(crate) struct FileEvidence {
+    /// Source SHA-256 the evidence is bound to.
+    pub(crate) sha256: String,
+    /// Largest covered line, or zero when the file has no points.
+    pub(crate) max_line: usize,
+    /// Range-count index over the covered lines.
+    pub(crate) index: CoverageIndex,
+}
+
+impl FileEvidence {
+    /// Compact a validated line map; keys were already checked to be canonical positive integers.
+    pub(crate) fn new(sha256: String, lines: std::collections::BTreeMap<String, u64>) -> Self {
+        let index = CoverageIndex::new(
+            lines
+                .into_iter()
+                .map(|(line, hits)| (line.parse::<usize>().expect("validated line"), hits)),
+        );
+        Self {
+            sha256,
+            max_line: index.lines.last().copied().unwrap_or(0),
+            index,
+        }
+    }
+}
