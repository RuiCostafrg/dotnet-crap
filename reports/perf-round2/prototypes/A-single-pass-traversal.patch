+#[allow(clippy::too_many_arguments)]
+fn single_pass(
+    kinds: &Kinds,
+    root: Node<'_>,
+    source: &str,
+    file: &str,
+    cov: Option<&CoverageIndex>,
+    out: &mut Vec<Item>,
+    traversal_budget: usize,
+    callable_budget: usize,
+) -> std::result::Result<(), Exceeded> {
+    let mut cursor = root.walk();
+    let mut scratch = root.walk();
+    let mut open: Vec<Open> = Vec::new();
+    let mut visited = 0usize;
+    let mut depth = 0u32;
+    'visit: loop {
+        let node = cursor.node();
+        visited += 1;
+        if visited > traversal_budget {
+            return Err(Exceeded);
+        }
+        let is_callable = kinds.callable(node);
+        if let Some(top) = open.last_mut() {
+            top.scored += 1;
+            if top.scored > callable_budget {
+                return Err(Exceeded);
+            }
+            if is_callable {
+                top.excluded
+                    .push((node.start_position().row + 1, node.end_position().row + 1));
+            } else {
+                top.complexity = top
+                    .complexity
+                    .checked_add(kinds.decision(node, &mut scratch))
+                    .ok_or(Exceeded)?;
+            }
+        }
+        if is_callable {
+            if callable_budget == 0 {
+                return Err(Exceeded);
+            }
+            let start = node.start_position();
+            out.push(Item {
+                file: file.to_owned(),
+                name: callable_name(node, source),
+                kind: node.kind().to_owned(),
+                line: start.row + 1,
+                column: start.column + 1,
+                end_line: node.end_position().row + 1,
+                complexity: 0,
+                coverage: None,
+                crap: 0.0,
+            });
+            open.push(Open {
+                item: out.len() - 1,
+                depth,
+                complexity: 1u32
+                    .checked_add(kinds.decision(node, &mut scratch))
+                    .ok_or(Exceeded)?,
+                scored: 1,
+                excluded: Vec::new(),
+            });
+        }
+        // Descend to the first named child (named_children skips anonymous tokens and never
+        // descends into them).
+        if cursor.goto_first_child() {
+            depth += 1;
+            loop {
+                if cursor.node().is_named() {
+                    continue 'visit;
+                }
+                if !cursor.goto_next_sibling() {
+                    break;
+                }
+            }
+            cursor.goto_parent();
+            depth -= 1;
+        }
+        // The current node's subtree is done: close it, then move to the next named sibling
+        // of the nearest ancestor that has one.
+        loop {
+            if open.last().is_some_and(|o| o.depth == depth) {
+                let done = open.pop().expect("open callable");
+                finish(done, cov, out);
+            }
+            if depth == 0 {
+                return Ok(());
+            }
+            while cursor.goto_next_sibling() {
+                if cursor.node().is_named() {
+                    continue 'visit;
+                }
+            }
+            cursor.goto_parent();
+            depth -= 1;
+        }
+    }
+}
