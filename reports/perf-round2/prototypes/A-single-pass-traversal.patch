+/// Syntactic role of a node kind, resolved once per language from kind names.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Class {
+    Other,
+    /// Callable kinds that count only with a `body` field.
+    CallableBody,
+    /// `anonymous_method_expression`: always a callable.
+    CallableAlways,
+    /// Property/indexer: callable when `value` is an arrow clause.
+    CallableArrow,
+    Arrow,
+    /// Kinds contributing exactly one decision.
+    Decision,
+    SwitchSection,
+    SwitchArm,
+    /// `binary_expression` / `assignment_expression`.
+    Logical,
+    Case,
+    Discard,
+    /// `&&`, `||`, `??`, `??=`.
+    LogicalOp,
+}
+
+/// Kind-id lookup table. Filled by *name* for every symbol id, so `class[n.kind_id()]` is
+/// exactly the string comparison on `n.kind()` (aliases and named/anonymous duplicates included).
+pub(crate) struct Kinds {
+    class: Vec<Class>,
+    body: Option<u16>,
+    value: Option<u16>,
+    operator: Option<u16>,
+}
+
+impl Kinds {
+    pub(crate) fn new(language: &tree_sitter::Language) -> Self {
+        let class = (0..language.node_kind_count())
+            .map(|id| match language.node_kind_for_id(id as u16).unwrap_or("") {
+                "method_declaration"
+                | "constructor_declaration"
+                | "operator_declaration"
+                | "conversion_operator_declaration"
+                | "destructor_declaration"
+                | "local_function_statement"
+                | "accessor_declaration"
+                | "lambda_expression" => Class::CallableBody,
+                "anonymous_method_expression" => Class::CallableAlways,
+                "property_declaration" | "indexer_declaration" => Class::CallableArrow,
+                "arrow_expression_clause" => Class::Arrow,
+                "if_statement" | "for_statement" | "foreach_statement" | "while_statement"
+                | "do_statement" | "catch_clause" | "conditional_expression" | "when_clause" => {
+                    Class::Decision
+                }
+                "switch_section" => Class::SwitchSection,
+                "switch_expression_arm" => Class::SwitchArm,
+                "binary_expression" | "assignment_expression" => Class::Logical,
+                "case" => Class::Case,
+                "discard" => Class::Discard,
+                "&&" | "||" | "??" | "??=" => Class::LogicalOp,
+                _ => Class::Other,
+            })
+            .collect();
+        let field = |name: &str| language.field_id_for_name(name).map(|f| f.get());
+        Self {
+            class,
+            body: field("body"),
+            value: field("value"),
+            operator: field("operator"),
+        }
+    }
+
+    #[inline]
+    fn of(&self, n: Node<'_>) -> Class {
+        self.class
+            .get(usize::from(n.kind_id()))
+            .copied()
+            .unwrap_or(Class::Other)
+    }
+
+    #[inline]
+    fn field<'t>(n: Node<'t>, id: Option<u16>) -> Option<Node<'t>> {
+        id.and_then(|id| n.child_by_field_id(id))
+    }
+
+    /// Integer-dispatch equivalent of [`callable`].
+    #[inline]
+    fn callable(&self, n: Node<'_>) -> bool {
+        match self.of(n) {
+            Class::CallableBody => Self::field(n, self.body).is_some(),
+            Class::CallableAlways => true,
+            Class::CallableArrow => {
+                Self::field(n, self.value).is_some_and(|v| self.of(v) == Class::Arrow)
+            }
+            _ => false,
+        }
+    }
+
+    /// Integer-dispatch equivalent of [`decision`]; `scratch` is a reusable cursor.
+    #[inline]
+    fn decision<'t>(&self, n: Node<'t>, scratch: &mut TreeCursor<'t>) -> u32 {
+        match self.of(n) {
+            Class::Decision => 1,
+            Class::SwitchSection => n
+                .children(scratch)
+                .filter(|child| self.of(*child) == Class::Case)
+                .count() as u32,
+            Class::SwitchArm => {
+                u32::from(n.named_child(0).is_none_or(|c| self.of(c) != Class::Discard))
+            }
+            // Operators are anonymous tokens whose text equals their kind name, and the
+            // grammar always stores them in `operator`.
+            Class::Logical => u32::from(
+                Self::field(n, self.operator).is_some_and(|op| self.of(op) == Class::LogicalOp),
+            ),
+            _ => 0,
+        }
+    }
+}
