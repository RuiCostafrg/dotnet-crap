+/// Fill the reserved item of a finished callable.
+fn finish(open: Open, cov: Option<&CoverageIndex>, out: &mut [Item]) {
+    let item = &mut out[open.item];
+    let ranges = merge_ranges(open.excluded);
+    let coverage = cov.and_then(|c| span_coverage(c, item.line, item.end_line, &ranges));
+    let missed = 1.0 - coverage.unwrap_or(0.0);
+    item.complexity = open.complexity;
+    item.coverage = coverage;
+    item.crap = f64::from(open.complexity).powi(2) * missed.powi(3) + f64::from(open.complexity);
+}
