+/// Benchmark-only variant: kind ids plus reused cursors, but still two walks (outer pre-order
+/// walk and a per-callable inner walk). Exact budget semantics without a fallback.
+#[cfg(test)]
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn collect_cursor_two_pass(
+    kinds: &Kinds,
+    root: Node<'_>,
+    source: &str,
+    file: &str,
+    cov: Option<&CoverageIndex>,
+    out: &mut Vec<Item>,
+    traversal_budget: usize,
+    callable_budget: usize,
+) -> Result<()> {
+    let mut cursor = root.walk();
+    let mut inner = root.walk();
+    let mut scratch = root.walk();
+    let mut visited = 0usize;
+    // Track depth by hand: TreeCursor::depth() is O(depth) in tree-sitter 0.27.
+    let mut outer_depth = 0u32;
+    'visit: loop {
+        let n = cursor.node();
+        visited += 1;
+        if visited > traversal_budget {
+            fail!(ResourceLimit, "syntax tree resource limit exceeded");
+        }
+        if kinds.callable(n) {
+            let mut complexity = 1u32;
+            let mut excluded = Vec::new();
+            let mut scored = 0usize;
+            inner.reset(n);
+            let mut depth = 0u32;
+            'inner: loop {
+                let node = inner.node();
+                scored += 1;
+                if scored > callable_budget {
+                    fail!(ResourceLimit, "callable resource limit exceeded");
+                }
+                let skip = depth > 0 && kinds.callable(node);
+                if skip {
+                    excluded.push((node.start_position().row + 1, node.end_position().row + 1));
+                } else {
+                    complexity = complexity
+                        .checked_add(kinds.decision(node, &mut scratch))
+                        .context(ErrorKind::ResourceLimit, "complexity overflow")?;
+                    if inner.goto_first_child() {
+                        depth += 1;
+                        loop {
+                            if inner.node().is_named() {
+                                continue 'inner;
+                            }
+                            if !inner.goto_next_sibling() {
+                                break;
+                            }
+                        }
+                        inner.goto_parent();
+                        depth -= 1;
+                    }
+                }
+                loop {
+                    if depth == 0 {
+                        break 'inner;
+                    }
+                    while inner.goto_next_sibling() {
+                        if inner.node().is_named() {
+                            continue 'inner;
+                        }
+                    }
+                    inner.goto_parent();
+                    depth -= 1;
+                }
+            }
+            let ranges = merge_ranges(excluded);
+            let start = n.start_position().row + 1;
+            let end = n.end_position().row + 1;
+            let coverage = cov.and_then(|c| span_coverage(c, start, end, &ranges));
+            let missed = 1.0 - coverage.unwrap_or(0.0);
+            out.push(Item {
+                file: file.to_owned(),
+                name: callable_name(n, source),
+                kind: n.kind().to_owned(),
+                line: start,
+                column: n.start_position().column + 1,
+                end_line: end,
+                complexity,
+                coverage,
+                crap: f64::from(complexity).powi(2) * missed.powi(3) + f64::from(complexity),
+            });
+        }
+        if cursor.goto_first_child() {
+            outer_depth += 1;
+            loop {
+                if cursor.node().is_named() {
+                    continue 'visit;
+                }
+                if !cursor.goto_next_sibling() {
+                    break;
+                }
+            }
+            cursor.goto_parent();
+            outer_depth -= 1;
+        }
+        loop {
+            if outer_depth == 0 {
+                return Ok(());
+            }
+            while cursor.goto_next_sibling() {
+                if cursor.node().is_named() {
+                    continue 'visit;
+                }
+            }
+            cursor.goto_parent();
+            outer_depth -= 1;
+        }
+    }
+}
