+            for tb in 0..=40 {
+                for cb in 0..=40 {
+                    let want = run_variant(reference, &kinds, &tree, src, None, tb, cb);
+                    for (vname, v) in VARIANTS {
+                        let got = run_variant(v, &kinds, &tree, src, None, tb, cb);
+                        assert_eq!(got, want, "{vname} tb={tb} cb={cb} src={src:.60}");
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    /// The kind table resolves every symbol name exactly like the string comparisons do.
+    fn kind_table_matches_string_classification_for_every_symbol() {
+        let lang = csharp();
+        let kinds = Kinds::new(&lang);
+        assert_eq!(kinds.class.len(), lang.node_kind_count());
+        let mut seen = std::collections::BTreeMap::<&str, Vec<(u16, bool)>>::new();
+        for id in 0..lang.node_kind_count() as u16 {
+            let name = lang.node_kind_for_id(id).unwrap();
+            seen.entry(name).or_default().push((id, lang.node_kind_is_named(id)));
+        }
+        for name in ["case", "&&", "??=", "lambda_expression", "discard", "arrow_expression_clause"] {
+            eprintln!("{name}: {:?}", seen.get(name));
+        }
+    }
+
+    fn env_usize(name: &str, default: usize) -> usize {
+        std::env::var(name)
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(default)
+    }
+
+    fn count_named(n: Node<'_>) -> usize {
+        let mut c = n.walk();
+        let mut total = 0;
+        let mut stack = vec![n];
+        while let Some(n) = stack.pop() {
+            total += 1;
+            stack.extend(n.named_children(&mut c));
+        }
+        total
+    }
+
+    fn stats(mut v: Vec<f64>) -> (f64, f64) {
+        v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        (v[0], v[v.len() / 2])
+    }
+
+    #[test]
+    #[ignore]
+    /// In-process micro-benchmark: parse vs each collect variant, interleaved, min/median of N.
+    /// A_BENCH_DIRS=dir1:dir2 (each a workload corpus), A_BENCH_ITERS (default 30).
+    fn prototype_bench() {
+        use std::time::Instant;
+        let iters = env_usize("A_BENCH_ITERS", 30);
+        let dirs = std::env::var("A_BENCH_DIRS").expect("A_BENCH_DIRS");
+        let kinds_lang = csharp();
+        for dir in dirs.split(':') {
+            let mut files = Vec::new();
+            cs_files(std::path::Path::new(dir), &mut files);
+            let sources: Vec<String> = files
+                .iter()
+                .map(|p| std::fs::read_to_string(p).unwrap())
+                .collect();
+            let trees: Vec<_> = sources.iter().map(|s| parse(s)).collect();
+            let nodes: usize = trees.iter().map(|t| count_named(t.root_node())).sum();
+            let mut parser = TsParser::new();
+            parser.set_language(&kinds_lang).unwrap();
+            let mut times: Vec<Vec<f64>> = vec![Vec::new(); 6];
+            let names = [
+                "parse",
+                "reference",
+                "ids_only",
+                "cursor_two_pass",
+                "single_pass",
+                "single_pass+table",
+            ];
+            let kinds = Kinds::new(&kinds_lang);
+            let mut items_n = 0;
+            for it in 0..iters {
+                // Rotate the order each iteration to spread drift across variants.
+                for k in 0..6 {
+                    let which = (k + it) % 6;
+                    let t = Instant::now();
+                    let mut out = Vec::new();
+                    for (src, tree) in sources.iter().zip(&trees) {
+                        let root = tree.root_node();
+                        match which {
+                            0 => {
+                                let t = parser.parse(src, None).unwrap();
+                                std::hint::black_box(&t);
+                            }
+                            1 => collect_reference(root, src, "F.cs", None, &mut out, 1_000_000, 1_000_000).unwrap(),
+                            2 => collect_ids_only(&kinds, root, src, "F.cs", None, &mut out, 1_000_000, 1_000_000).unwrap(),
+                            3 => collect_cursor_two_pass(&kinds, root, src, "F.cs", None, &mut out, 1_000_000, 1_000_000).unwrap(),
+                            4 => collect_with_kinds(&kinds, root, src, "F.cs", None, &mut out, 1_000_000, 1_000_000).unwrap(),
+                            _ => collect(root, src, "F.cs", None, &mut out, 1_000_000, 1_000_000).unwrap(),
+                        }
+                    }
+                    times[which].push(t.elapsed().as_secs_f64() * 1e3);
+                    if which == 1 {
+                        items_n = out.len();
+                    }
+                    std::hint::black_box(&out);
+                }
+            }
+            let (pmin, pmed) = stats(times[0].clone());
+            let (rmin, rmed) = stats(times[1].clone());
+            println!(
+                "## {dir}: files={} named_nodes={nodes} items={items_n} iters={iters}",
+                files.len()
+            );
+            for (i, name) in names.iter().enumerate() {
+                let (mn, md) = stats(times[i].clone());
+                let ns_node = mn * 1e6 / nodes as f64;
+                let saved = if i >= 2 {
+                    format!(
+                        " saved_vs_ref(min)={:.1}% of parse+collect, collect speedup x{:.2}",
+                        (rmin - mn) / (pmin + rmin) * 100.0,
+                        rmin / mn
+                    )
+                } else {
+                    String::new()
+                };
+                println!("{name:>18}: min {mn:8.2} ms  med {md:8.2} ms  {ns_node:6.1} ns/node{saved}");
+            }
+            println!("   parse+ref(med) {:.2} ms", pmed + rmed);
+        }
+    }
 }
