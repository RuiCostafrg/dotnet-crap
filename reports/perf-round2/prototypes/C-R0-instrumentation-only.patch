new file mode 100644
index 0000000..704ef55
--- /dev/null
+++ b/src/prof.rs
@@ -0,0 +1,91 @@
+//! Investigation-only work counters and phase timers for `collect`.
+//! Compiled to no-ops unless the `collect-profile` feature is enabled.
+
+/// Counted work units.
+#[derive(Clone, Copy)]
+#[allow(dead_code)]
+pub(crate) enum Counter {
+    /// Source file reads (any purpose).
+    SourceRead,
+    /// SHA-256 computations over source bytes.
+    Hash,
+    /// Source decodes.
+    Decode,
+    /// Tree-sitter parses.
+    Parse,
+    /// `canonicalize` calls.
+    Canonicalize,
+    /// Bytes copied by the Cobertura lowercase scan.
+    LowercaseBytes,
+    /// Bytes of decoded source text retained in the collect sources map.
+    RetainedSourceBytes,
+}
+
+#[cfg(feature = "collect-profile")]
+mod imp {
+    use super::Counter;
+    use std::sync::Mutex;
+    use std::time::{Duration, Instant};
+    static COUNTS: Mutex<[u64; 7]> = Mutex::new([0; 7]);
+    static PHASES: Mutex<Vec<(&'static str, Duration)>> = Mutex::new(Vec::new());
+    const NAMES: [&str; 7] = [
+        "source_read",
+        "hash",
+        "decode",
+        "parse",
+        "canonicalize",
+        "lowercase_bytes",
+        "retained_source_bytes",
+    ];
+    pub(crate) fn add(c: Counter, n: u64) {
+        COUNTS.lock().unwrap()[c as usize] += n;
+    }
+    pub(crate) struct Phase(&'static str, Instant);
+    pub(crate) fn phase(name: &'static str) -> Phase {
+        Phase(name, Instant::now())
+    }
+    impl Drop for Phase {
+        fn drop(&mut self) {
+            let mut p = PHASES.lock().unwrap();
+            let e = self.1.elapsed();
+            match p.iter_mut().find(|(n, _)| *n == self.0) {
+                Some(slot) => slot.1 += e,
+                None => p.push((self.0, e)),
+            }
+        }
+    }
+    pub(crate) fn report() {
+        let c = COUNTS.lock().unwrap();
+        let mut s = String::from("{\"counts\":{");
+        for (i, n) in NAMES.iter().enumerate() {
+            s += &format!("{}\"{}\":{}", if i > 0 { "," } else { "" }, n, c[i]);
+        }
+        s += "},\"phases_us\":{";
+        for (i, (n, d)) in PHASES.lock().unwrap().iter().enumerate() {
+            s += &format!(
+                "{}\"{}\":{}",
+                if i > 0 { "," } else { "" },
+                n,
+                d.as_micros()
+            );
+        }
+        s += "}}";
+        eprintln!("COLLECT-PROFILE {s}");
+    }
+}
+
+#[cfg(not(feature = "collect-profile"))]
+mod imp {
+    use super::Counter;
+    #[inline(always)]
+    pub(crate) fn add(_: Counter, _: u64) {}
+    pub(crate) struct Phase;
+    #[inline(always)]
+    pub(crate) fn phase(_: &'static str) -> Phase {
+        Phase
+    }
+    #[inline(always)]
+    pub(crate) fn report() {}
+}
+
+pub(crate) use imp::{add, phase, report};
