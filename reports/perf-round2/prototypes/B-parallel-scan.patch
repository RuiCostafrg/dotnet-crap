+//! Deterministic ordered parallel map over indexed work items (std only).
+//!
+//! Workers claim indices from one atomic counter and store a per-index result.
+//! The caller receives results in index order, or the error of the lowest
+//! failing index, exactly like a sequential `for` loop with `?`.
+
+use crate::error::Result;
+use std::{
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        Mutex,
+    },
+    thread,
+};
+
+/// Environment variable capping the worker count; `1` selects the sequential path.
+pub(crate) const JOBS_ENV: &str = "DOTNET_CRAP_THREADS";
+
+/// Worker cap: the environment override if valid, else the available cores.
+pub(crate) fn default_cap() -> usize {
+    std::env::var(JOBS_ENV)
+        .ok()
+        .and_then(|v| v.trim().parse::<usize>().ok())
+        .filter(|&n| n > 0)
+        .unwrap_or_else(|| thread::available_parallelism().map_or(1, usize::from))
+}
+
+/// Worker count for `items` units of work under `cap`: never above `items`, never zero.
+pub(crate) fn workers_for(items: usize, cap: usize) -> usize {
+    cap.min(items).max(1)
+}
+
+/// Run `work(state, index)` for every index in `0..items` using one state per worker.
+///
+/// `states` fixes the worker count (one thread per state; a single state runs inline
+/// on the calling thread without spawning). Returns the results in index order, or the
+/// error with the lowest index. Indices above the lowest known failure are skipped, so
+/// work past the first error is cancelled, but every index below it is always completed.
+pub(crate) fn ordered_map<S: Send, T: Send>(
+    items: usize,
+    mut states: Vec<S>,
+    work: impl Fn(&mut S, usize) -> Result<T> + Sync,
+) -> Result<Vec<T>> {
+    if states.len() <= 1 {
+        let mut state = states.pop();
+        return (0..items)
+            .map(|i| work(state.as_mut().expect("one state"), i))
+            .collect();
+    }
+    let next = AtomicUsize::new(0);
+    let first_failure = AtomicUsize::new(usize::MAX);
+    let slots: Vec<Mutex<Option<Result<T>>>> = (0..items).map(|_| Mutex::new(None)).collect();
+    thread::scope(|scope| {
+        for state in &mut states {
+            let (next, first_failure, slots, work) = (&next, &first_failure, &slots, &work);
+            scope.spawn(move || loop {
+                let i = next.fetch_add(1, Ordering::Relaxed);
+                if i >= items || i > first_failure.load(Ordering::Relaxed) {
+                    return;
+                }
+                let result = work(state, i);
+                if result.is_err() {
+                    first_failure.fetch_min(i, Ordering::Relaxed);
+                }
+                *slots[i].lock().unwrap_or_else(|e| e.into_inner()) = Some(result);
+            });
+        }
+    });
+    slots
+        .into_iter()
+        .map(|slot| {
+            slot.into_inner()
+                .unwrap_or_else(|e| e.into_inner())
+                .expect("every index up to the first failure is completed")
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::error::{fail, ErrorKind};
+    use std::time::Duration;
+
+    #[test]
+    fn workers_are_capped_by_items_and_never_zero() {
+        assert_eq!(workers_for(0, 8), 1);
+        assert_eq!(workers_for(1, 8), 1);
+        assert_eq!(workers_for(3, 8), 3);
+        assert_eq!(workers_for(100, 8), 8);
+        assert_eq!(workers_for(100, 0), 1);
+    }
+
+    #[test]
+    fn results_keep_index_order_for_any_worker_count() {
+        for workers in 1..=6 {
+            let out = ordered_map(50, vec![(); workers], |(), i| Ok(i * 2)).unwrap();
+            assert_eq!(out, (0..50).map(|i| i * 2).collect::<Vec<_>>());
+        }
+        assert!(ordered_map(0, vec![(); 4], |(), i| Ok(i))
+            .unwrap()
+            .is_empty());
+    }
+
+    #[test]
+    fn lowest_failing_index_wins_even_when_a_later_one_fails_first() {
+        for _ in 0..40 {
+            let error = ordered_map(8, vec![(); 4], |(), i| match i {
+                // The earliest failure is slow; later failures finish immediately.
+                2 => {
+                    thread::sleep(Duration::from_millis(15));
+                    fail!(Syntax, "failure 2")
+                }
+                5 | 7 => fail!(Io, "failure later"),
+                _ => Ok(i),
+            })
+            .unwrap_err();
+            assert_eq!(error.to_string(), "failure 2");
+            assert_eq!(error.kind(), ErrorKind::Syntax);
+        }
+    }
+
+    #[test]
+    fn work_after_the_first_failure_is_cancelled() {
+        let calls = AtomicUsize::new(0);
+        let error = ordered_map(10_000, vec![(); 2], |(), i| {
+            calls.fetch_add(1, Ordering::Relaxed);
+            if i == 0 {
+                fail!(Io, "boom");
+            }
+            thread::sleep(Duration::from_micros(200));
+            Ok(i)
+        })
+        .unwrap_err();
+        assert_eq!(error.to_string(), "boom");
+        assert!(calls.load(Ordering::Relaxed) < 10_000);
+    }
+
+    #[test]
+    fn a_single_state_runs_inline_and_stops_at_the_first_failure() {
+        let main = thread::current().id();
+        let calls = AtomicUsize::new(0);
+        let error = ordered_map(5, vec![()], |(), i| {
+            assert_eq!(thread::current().id(), main);
+            calls.fetch_add(1, Ordering::Relaxed);
+            if i == 2 {
+                fail!(Io, "stop");
+            }
+            Ok(i)
+        })
+        .unwrap_err();
+        assert_eq!(error.to_string(), "stop");
+        assert_eq!(calls.load(Ordering::Relaxed), 3);
+    }
+}
