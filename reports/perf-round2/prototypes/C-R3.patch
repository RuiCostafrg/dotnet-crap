+/// Bind one validated coverage entry to a scanned source: the entry must carry
+/// the source's hash and stay within its `str::lines` count.
+fn check_binding(c: &CoverageFile, hash: &str, line_count: usize, relative: &str) -> Result<()> {
+    if !hash.eq_ignore_ascii_case(&c.sha256) {
+        fail!(Coverage, "stale coverage for {relative}");
+    }
+    if c.lines
+        .keys()
+        .any(|l| l.parse::<usize>().unwrap_or(usize::MAX) > line_count)
+    {
+        fail!(Coverage, "coverage line outside {relative}");
+    }
+    Ok(())
+}
+
+/// Read native coverage with scan's reader and validator, then bind every
+/// entry for a snapshot source exactly as a scan of the unchanged snapshot
+/// bytes would. `files` holds `(relative, sha256, line_count)` in scan order;
+/// entries for unselected files are ignored, as in scan.
+pub(crate) fn check_coverage_against_snapshot(
+    coverage: &Path,
+    files: &[(String, String, usize)],
+) -> Result<()> {
+    let coverage = evidence::read(coverage)?;
+    evidence::validate(&coverage)?;
+    for (relative, hash, line_count) in files {
+        if let Some(c) = coverage.files.get(relative) {
+            check_binding(c, hash, *line_count, relative)?;
+        }
+    }
+    Ok(())
+}
