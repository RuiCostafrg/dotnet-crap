<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(DOTNET_CRAP_TEST_TFM)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(DOTNET_CRAP_TEST_TFM)' != ''">$(DOTNET_CRAP_TEST_TFM)</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Alpha.Library/Alpha.Library.csproj" />
  </ItemGroup>
</Project>
