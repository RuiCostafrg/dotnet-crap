<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(DOTNET_CRAP_TEST_TFM)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(DOTNET_CRAP_TEST_TFM)' != ''">$(DOTNET_CRAP_TEST_TFM)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Alpha.Library/Alpha.Library.csproj" />
  </ItemGroup>
</Project>
